# Supabase — from your project's Settings > API page.
# NEXT_PUBLIC_* values are exposed to the browser; that's expected for the URL
# and anon key (RLS protects data, not these values). The service role key and
# Gemini key are server-only secrets and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — server-side only, used for bounded dosage
# suggestions and custom-protocol-document parsing. Never sent to the client.
GEMINI_API_KEY=

# Public site URL, used to build the email-confirmation redirect link sent
# by Supabase Auth. Leave unset locally (falls back to http://localhost:3000)
# — production's value lives in the committed .env.production instead, since
# NEXT_PUBLIC_* vars are baked in at build time and .env.local would
# otherwise take priority over it.
# NEXT_PUBLIC_SITE_URL=

# For local `wrangler`/`opennextjs-cloudflare` preview + deploy, set the
# secrets (SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY) via
# `wrangler secret put <NAME>` rather than committing them here.
