# Supabase — from your project's Settings > API page.
# NEXT_PUBLIC_* values are exposed to the browser; that's expected for the URL
# and anon key (RLS protects data, not these values). The service role key and
# Gemini key are server-only secrets and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — server-side only, used for bounded dosage
# suggestions and custom-protocol-document parsing. Never sent to the client.
# If unset, dosage suggestions are skipped (plan generation still succeeds,
# just with no suggested sets/reps/frequency) rather than failing.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# Public site URL, used to build the email-confirmation redirect link sent
# by Supabase Auth. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For local `wrangler`/`opennextjs-cloudflare` preview + deploy, set the same
# secrets via `wrangler secret put <NAME>` rather than committing them here.
