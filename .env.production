# Loaded automatically by `next build` (NODE_ENV=production) — including
# the `opennextjs-cloudflare build` step `npm run deploy` runs. Not a
# secret: NEXT_PUBLIC_* values ship to the browser regardless, and this is
# just the app's own public URL. It's committed (see .gitignore) so a
# forgotten env var can't silently bake `localhost` into a production
# deploy again — see the emailRedirectTo bug this fixed.
NEXT_PUBLIC_SITE_URL=https://achilla.dguo11.workers.dev

# Also not a secret: the anon key is meant to ship to the browser and is
# only as sensitive as Supabase's Row Level Security policies make it.
# Committed for the same reason as NEXT_PUBLIC_SITE_URL above — a deploy
# from a clean checkout (no local .env.local) previously built with these
# undefined and took production down with "Your project's URL and Key are
# required to create a Supabase client!".
NEXT_PUBLIC_SUPABASE_URL=https://ikybgplqujpurzjzpdjr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlreWJncGxxdWpwdXJ6anpwZGpyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU3Njk5NTcsImV4cCI6MjEwMTM0NTk1N30.5gMaBXydiZ7KS-LYL5tRDFpTyA4kr6dbkEOTeq3kGb0
