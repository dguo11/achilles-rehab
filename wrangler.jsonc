{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "achilla",
  // Set this to today's date when bumping; must be 2024-09-23 or later for @opennextjs/cloudflare.
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret. Secrets (SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY) are
    // set with `wrangler secret put`, not here.
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  }
}
